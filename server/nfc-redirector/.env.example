# Cổng host ánh xạ ra ngoài (Nginx reverse proxy sẽ trỏ về cổng này)
HOST_PORT=3080

# Mã bí mật khớp với #define NFC_CHECKIN_SECRET trong include/Config.h của ESP32
CHECKIN_SECRET=smartdesk-2026

# Khóa xem danh sách máy tại GET /admin/devices?key=... (để trống nếu muốn tắt)
ADMIN_KEY=change-me-admin-secret
